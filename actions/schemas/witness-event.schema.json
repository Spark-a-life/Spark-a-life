{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aios/witness-event.schema.json",
  "title": "AIOS Witness Chain Action Event",
  "description": "Witness event aligned to v1.2 §30 and §31. Technical execution state is separate from business outcome state. approval_id may be null for Green events that policy allows without an individual gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "case_id",
    "proposal_id",
    "proposal_digest",
    "action_class",
    "action_state",
    "business_outcome_state",
    "requested_at",
    "protocol_version",
    "schema_version",
    "policy_version"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "proposal_digest": {
      "type": "string",
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval_id": { "type": ["string", "null"] },
    "action_id": { "type": "string" },
    "action_class": {
      "type": "string",
      "enum": ["GREEN", "AMBER", "RED", "PROHIBITED"]
    },
    "action_state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "AWAITING_AUTHORISATION",
        "AUTHORISED",
        "REJECTED",
        "EXPIRED",
        "REVOKED",
        "EXECUTING",
        "SUCCEEDED",
        "FAILED",
        "PARTIALLY_SUCCEEDED",
        "INDETERMINATE",
        "ROLLED_BACK",
        "IRREVERSIBLE"
      ]
    },
    "business_outcome_state": {
      "type": "string",
      "enum": [
        "NOT_ASSESSED",
        "PENDING",
        "OBSERVED",
        "NOT_ACHIEVED",
        "CONFLICTED",
        "INDETERMINATE"
      ]
    },
    "approver_identity": { "type": ["string", "null"] },
    "requested_at": { "type": "string", "format": "date-time" },
    "issued_or_approved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "executed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "target_system": { "type": "string" },
    "target_entity": { "type": "string" },
    "information_disclosed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "external_reference": { "type": ["string", "null"] },
    "error_or_variance": { "type": ["string", "null"] },
    "rollback_state": { "type": ["string", "null"] },
    "receipt_id": { "type": ["string", "null"] },
    "protocol_version": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "previous_event_id": { "type": ["string", "null"] },
    "amendment_reference": { "type": ["string", "null"] }
  }
}
