{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aios/approval.schema.json",
  "title": "AIOS Action Approval",
  "description": "v1.2 §27.3 externally verifiable approval record. Server-issued and server-validated. Model-generated approval text is not an approval record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "approver_identity",
    "proposal_id",
    "proposal_version",
    "proposal_digest",
    "approved_scope",
    "decision",
    "issued_at",
    "expires_at",
    "single_use_or_reusable",
    "revocation_status",
    "policy_version"
  ],
  "properties": {
    "approval_id": { "type": "string", "minLength": 1 },
    "approver_identity": { "type": "string", "minLength": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "proposal_version": { "type": "integer", "minimum": 1 },
    "proposal_digest": {
      "type": "string",
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target_system", "target_entity"],
      "properties": {
        "action_type": { "type": "string", "minLength": 1 },
        "target_system": { "type": "string", "minLength": 1 },
        "target_entity": { "type": "string", "minLength": 1 },
        "recipient_or_affected_party": { "type": "string" },
        "data_scope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "DENIED"]
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "single_use_or_reusable": {
      "type": "string",
      "enum": ["SINGLE_USE", "REUSABLE"]
    },
    "revocation_status": {
      "type": "string",
      "enum": ["ACTIVE", "REVOKED", "EXPIRED"]
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "approval_evidence_reference": { "type": "string" }
  }
}
