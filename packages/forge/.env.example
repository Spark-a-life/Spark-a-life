# WiseGen Forge configuration. Every value has a safe default; nothing here is required to run.
FORGE_ESTATE=local                  # local | docker | kubernetes | customer-vpc | air-gapped
FORGE_REPO_ROOT=.
FORGE_RUN_ROOT=.forge
FORGE_MODEL_PROFILE=deterministic   # deterministic | anthropic | ollama
FORGE_NETWORK=deny                  # deny | allow-listed
FORGE_BUDGET_SGD=25.00              # project cost cap, SGD is the default currency
FORGE_BUDGET_TOKENS=2000000
FORGE_BUDGET_TOOL_CALLS=500
FORGE_APPROVAL_MODE=captain         # captain | dual-control
FORGE_RETENTION_DAYS=2555
# Secrets are read from the environment only, never written to evidence or witness records.
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
