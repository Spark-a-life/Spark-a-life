{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisegen.forge/schemas/specification.schema.json",
  "title": "Specification",
  "description": "The authoritative artefact. Code, tests and deployment are derived from it, and drift is measured against it. Generation never proceeds on unstated acceptance criteria.",
  "type": "object",
  "required": ["objective", "users", "outcomes", "constraints", "acceptance_criteria", "risk_tier"],
  "properties": {
    "objective": { "type": "string", "minLength": 10 },
    "users": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Each criterion must map to at least one executable check." },
    "risk_tier": { "type": "string", "enum": ["low", "medium", "high"] },
    "data_subjects": { "type": "array", "items": { "type": "string" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } }
  }
}
