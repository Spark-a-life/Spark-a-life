{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisegen.forge/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "description": "Deployment happens through signed manifests, never through conversational instruction. A manifest without an approval reference or a rollback target is refused.",
  "type": "object",
  "required": ["release", "target_estate", "environment", "artefact_digest", "approvals", "rollback_release", "evidence_bundle", "signature"],
  "properties": {
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "target_estate": { "type": "string", "enum": ["managed-cloud", "customer-vpc", "on-premises", "local-workstation", "air-gapped"] },
    "environment": { "type": "string", "enum": ["development", "staging", "production"] },
    "artefact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approvals": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Gate packet ids carrying an approving decision." },
    "rollback_release": { "type": "string", "description": "Prior release to reverse to, or an explicit initial-release statement." },
    "evidence_bundle": { "type": "string" },
    "signature": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
