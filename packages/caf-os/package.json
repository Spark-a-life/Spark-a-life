{
  "name": "@spark-a-life/caf-os",
  "version": "1.0.0",
  "private": true,
  "description": "Governance-first conversational AI filmmaking operating system",
  "type": "module",
  "exports": {
    ".": "./src/core/service.js",
    "./cli": "./src/cli.js",
    "./api": "./src/api/server.js",
    "./mcp": "./src/mcp/server.js"
  },
  "bin": {
    "wisegen-caf": "src/cli.js"
  },
  "files": [
    "src/",
    "configs/",
    "schemas/",
    "prompts/",
    "examples/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "node src/cli.js",
    "api": "node src/api/server.js",
    "mcp": "node src/mcp/server.js",
    "test": "node --test",
    "lint": "node --check src/cli.js && node --check src/api/server.js && node --check src/mcp/server.js",
    "build": "node scripts/build.js",
    "demo": "node src/cli.js demo",
    "init-project": "node src/cli.js init",
    "route": "node src/cli.js route",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "ai-filmmaking",
    "conversational-ai",
    "production-control",
    "governance",
    "mcp",
    "witness-chain"
  ],
  "author": "Spark-a-life | APE Intelligence",
  "license": "MIT",
  "homepage": "https://spark-a-life.github.io/Spark-a-life/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spark-a-life/wisegen-caf-os.git"
  }
}
