{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAF Project",
  "type": "object",
  "required": [
    "id",
    "title",
    "purpose",
    "audience",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}