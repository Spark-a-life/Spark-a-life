# Safe for the bundled local demonstration only. Production mode refuses these values.
RUNTIME_MODE=demo
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
CONTROL_API_KEY=demo-control-api-key-rotate-before-use
WITNESS_HMAC_KEY=demo-witness-hmac-key-rotate-before-use-32bytes
APPROVAL_HMAC_KEY=demo-approval-hmac-key-rotate-before-use-32bytes
WITNESS_LOG_PATH=var/witness/witness-chain.jsonl
APPROVAL_STORE_PATH=var/approvals/used-nonces.json
STATE_STORE_PATH=var/state
CHROMIUM_PATH=/usr/bin/chromium
TARGET_BASE_URL=http://127.0.0.1:8899
BROWSER_DEMO_ROOT=fixtures
BROWSER_DEMO_FILE=fixtures/browser-demo.html
