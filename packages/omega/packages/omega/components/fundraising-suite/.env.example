# WiseGen MAMT Fundraising Suite environment schema
# This local-first reference implementation does not require external model credentials.

WISEGEN_ENV=local
WISEGEN_AUDIT_PATH=outputs/witness_chain.jsonl
WISEGEN_DEFAULT_ADAPTER=local_deterministic
WISEGEN_MAX_COST_USD=5
WISEGEN_MAX_EXTERNAL_CALLS=0
WISEGEN_REQUIRE_HUMAN_APPROVAL=true
WISEGEN_ALLOWED_MODEL_CLASSES=local_deterministic,manual_bridge,high_reasoning,fast_drafting,retrieval_synthesis
WISEGEN_DATA_ROOM_ROOT=outputs/data_room
