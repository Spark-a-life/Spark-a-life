{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project",
    "intent",
    "audience",
    "evidence",
    "workflow"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": [
        "decision",
        "purpose",
        "success_criteria"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": [
        "primary",
        "knowledge_level",
        "desired_action"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_level": {
          "enum": [
            "novice",
            "intermediate",
            "expert",
            "mixed"
          ]
        },
        "desired_action": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "fact",
              "source",
              "assumption",
              "constraint",
              "metric"
            ]
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "template",
        "release_threshold"
      ],
      "properties": {
        "template": {
          "type": "string"
        },
        "release_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_human_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}