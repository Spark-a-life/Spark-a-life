{
  "release": {
    "name": "WiseGen MAIE HRBP Demand Intelligence",
    "version": "0.1.0",
    "date": "2026-07-28",
    "owner": "Spark-a-life",
    "licence": "Apache-2.0"
  },
  "target_baseline": {
    "system": "WiseGen APE Intelligence OS",
    "version": "0.1.0"
  },
  "estate": {
    "id": "MAIE",
    "human_gate": [
      "employment-impacting recommendations",
      "organisation-wide policy",
      "performance or disciplinary decisions"
    ]
  },
  "capabilities": [
    {
      "id": "maie.demand-signal-harvest",
      "risk_ceiling": "medium",
      "status": "certified"
    },
    {
      "id": "maie.work-distribution-analysis",
      "risk_ceiling": "medium",
      "status": "certified"
    },
    {
      "id": "maie.coverage-model-recommend",
      "risk_ceiling": "high",
      "status": "certified",
      "human_approval_for": [
        "all"
      ],
      "routing_dependency": "capability.evaluate.routing"
    }
  ],
  "automatic_denials_added": [
    "individual_performance_inference",
    "individual_employee_identification",
    "unaggregated_er_case_ingestion",
    "headcount_reduction_directive",
    "coverage_recommendation_without_route_certification"
  ],
  "verification": {
    "scorer_tests": "11 passed",
    "capability_schema": "3/3 conform",
    "action_request_schema": "5/5 conform",
    "captains_gate": "5/5 as designed",
    "os_verify": "valid",
    "os_tests": "pass"
  },
  "findings_against_baseline": [
    "second_review declared for high tier is never read by the gate implementation",
    "capability schema omits permitted_data_classifications and human_approval_for which the registry dereferences",
    "registry previously held no MAIE capability, leaving the estate human gate unreachable"
  ],
  "trust_boundary": "Demand rubric is provisional: weights encode professional judgement and are not fitted against outcome data. Confidence is capped at 0.95. Sample portfolio is synthetic. No client data present.",
